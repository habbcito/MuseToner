<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:MuseToner.App.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="MuseToner.App.Views.MainWindow"
        Icon="/Assets/icon_app.ico"
        Title="MuseToner"
        FontFamily="{StaticResource TitleFont}"
        Width="1280" Height="720"
        Background="#FF171717"
        Foreground="White">

    <Window.Styles>
        <!-- Mantiene el color del botón al pasar el mouse (con un tono más claro) -->
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FFB84DFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="40,24">

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   x:Name="TitleText"
                   Text="MuseToner"
                   FontSize="100"
                   FontWeight="Bold"
                   Foreground="#FFA200FF"
                   HorizontalAlignment="Center" />

        <!-- Barra de controles (arriba) -->
        <Grid Grid.Row="1"
              Margin="0,16"
              ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto">

            <!-- Selección de archivo -->
            <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="Select_File"
                        Content="Examinar Archivo"
                        FontFamily="{StaticResource BodyFont}"
                        Click="OnButtonClick"
                        Background="#FFA200FF"
                        Foreground="White"
                        Height="32"
                        HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Original -->
            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Tonalidad Original"
                           x:Name = "OriginalKeyLabel"
                           FontFamily="{StaticResource BodyFont}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#FFFF007F"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="Tonic_Input"
                              Width="72" Height="32"
                              Padding="6,4" FontSize="13"
                              FontFamily="{StaticResource BodyFont}"
                              Background="#FF00FF66"
                              Foreground="Black"
                              SelectionChanged="OnOriginalKeyChanged"
                              SelectedIndex="0">
                    </ComboBox>
                    <ComboBox x:Name="Type_Input"
                              Width="104" Height="32"
                              Padding="6,4" FontSize="13"
                              FontFamily="{StaticResource BodyFont}"
                              Background="#FF00F0FF"
                              Foreground="Black"
                              SelectionChanged="OnOriginalKeyChanged"
                              SelectedIndex="0">
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Final -->
            <StackPanel Grid.Column="4" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Tonalidad Final"
                           x:Name = "FinalKeyLabel"
                           FontSize="14"
                           FontFamily="{StaticResource BodyFont}"
                           FontWeight="Bold"
                           Foreground="#FFFF007F"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="Tonic_Output"
                              Width="72" Height="32"
                              Padding="6,4" FontSize="13"
                              FontFamily="{StaticResource BodyFont}"
                              Background="#FF00FF66"
                              Foreground="Black"
                              SelectedIndex="0">
                    </ComboBox>
                    <ComboBox x:Name="Type_Output"
                              Width="104" Height="32"
                              Padding="6,4" FontSize="13"
                              FontFamily="{StaticResource BodyFont}"
                              Background="#FF00F0FF"
                              Foreground="Black"
                              SelectedIndex="0">
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <!-- Guardar -->
            <Button Grid.Column="6"
                    x:Name="Save_File"
                    Content="Guardar Archivo"
                    FontFamily="{StaticResource BodyFont}"
                    Click="OnSaveClick"
                    Background="#FFA200FF"
                    Foreground="White"
                    Width="128" Height="32"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- Mensajes de estado -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Text="¡Bienvenid@ a MuseToner!"
                   FontFamily="{StaticResource BodyFont}"
                   Foreground="#FFA1A1A1"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   HorizontalAlignment="Center"
                   TextAlignment="Center" />

        <!-- Marcador del piano roll (ocupa todo el espacio restante) -->
        <ScrollViewer Grid.Row="3"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
            <Grid ColumnDefinitions="Auto,*">

                <controls:PianoKeysControl Grid.Column="0" />

                <ScrollViewer Grid.Column="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">
                    <controls:PianoRollControl x:Name="PianoRoll" />
                </ScrollViewer>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>